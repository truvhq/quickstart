# please set your <Client ID>
API_CLIENT_ID=

# please set your <Access key>
API_SECRET=

# you can choose a different product type, just uncomment the line
API_PRODUCT_TYPE=income
# API_PRODUCT_TYPE=employment
# API_PRODUCT_TYPE=deposit_switch
# API_PRODUCT_TYPE=pll
# API_PRODUCT_TYPE=admin
#
# IS_ORDER controls how the bridge token is obtained. When true, the bridge token
# is retrieved via the Orders API; when false or unset, a user is created first
# and the bridge token is requested for that user. Orders are recommended for
# home lending and social services use cases when multiple incomes or assets
# need to be connected.
IS_ORDER=true
