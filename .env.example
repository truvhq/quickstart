# please set your <Client ID>
API_CLIENT_ID=

# please set your <Access key>
API_SECRET=

# you can choose a different product type, just uncomment the line
API_PRODUCT_TYPE=income
# API_PRODUCT_TYPE=employment
# API_PRODUCT_TYPE=deposit_switch
# API_PRODUCT_TYPE=pll
# API_PRODUCT_TYPE=admin
#
# IS_ORDER controls how the bridge token is obtained. When true, unset, or blank,
# the bridge token is retrieved via the Orders API; set to "false" to create a
# user first and request the bridge token for that user. Accepts "true" or "false"
# (case-insensitive). Orders are recommended for home lending and social services
# use cases when multiple incomes or assets need to be connected.
IS_ORDER=true
