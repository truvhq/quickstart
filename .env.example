# please set your <Client ID>
API_CLIENT_ID=

# please set your <Access key>
API_SECRET=

# you can choose a different product type, just uncomment the line
# API_PRODUCT_TYPE=employment
API_PRODUCT_TYPE=income
# API_PRODUCT_TYPE=deposit_switch
# API_PRODUCT_TYPE=pll
# API_PRODUCT_TYPE=admin

# Ngrok URL for receiving webhooks
# 1. Install ngrok: brew install ngrok
# 2. Sign up at https://ngrok.com and add your authtoken:
#    ngrok config add-authtoken <your-token>
# 3. Start the tunnel: ngrok http 3001
# 4. Copy the Forwarding URL and paste it here:
# NGROK_URL=https://xxxx-xxxx-xxxx.ngrok-free.app
