# please set your <Client ID>
API_CLIENT_ID=

# please set your <Access key>
API_SECRET=

# you can choose a different product type, just uncomment the line
API_PRODUCT_TYPE=income
# API_PRODUCT_TYPE=employment
# API_PRODUCT_TYPE=deposit_switch
# API_PRODUCT_TYPE=pll
# API_PRODUCT_TYPE=admin
#
# IS_ORDER controls bridge token initialization: when true, an order is created
# instead of a user. Supported in Node.js, Go, Python, C#, and Ruby. When unset
# or false, the previous user-based behavior is preserved for backward compatibility.
IS_ORDER=true
